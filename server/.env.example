# Server environment variables
# Copy to .env and fill in real values. Never commit the real .env file.

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Hotel_Management_System

# JWT signing secret (required in production). Access tokens expire in 15 minutes.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=15m

# Server-side pepper appended to passwords before bcrypt hashing. Stored ONLY here, never in the database.
PEPPER=change_me_to_another_long_random_string

# Refresh-token / session lifetime in days (httpOnly cookie + server-side store)
REFRESH_TTL_DAYS=7

# bcrypt cost factor (default 10)
BCRYPT_ROUNDS=10

# FastAPI runtime
PORT=5001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
