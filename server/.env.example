# Server environment variables
# Copy to .env and fill in real values. Never commit the real .env file.

# Server
PORT=5000
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:3000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Hotel_Management_System

# JWT signing secret (at least 32 random characters). Access tokens expire in 15 minutes.
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Server-side pepper appended to passwords before bcrypt hashing. Stored ONLY here, never in the database.
PEPPER=

# Refresh-token / session lifetime in days (httpOnly cookie + server-side store)
REFRESH_TTL_DAYS=7

# bcrypt cost factor (default 10)
BCRYPT_ROUNDS=10

# Supply private demo credentials before running npm run db:init.
DEMO_GUEST_PASSWORD=
DEMO_GUEST_ALT_PASSWORD=
DEMO_ADMIN_PASSWORD=
DEMO_SECOND_ADMIN_PASSWORD=
DEMO_RECEPTIONIST_PASSWORD=
